---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import KbHero from "../../../components/KbHero.astro";
import { fmt, localePaths, t } from "../../../i18n";
import { KB_SECTIONS, kbPath } from "../../../lib/kb";
import { breadcrumbs } from "../../../lib/structured-data";
import { BOOK_SIZE, bookText, tabaqatBooks } from "../../../lib/tabaqat";
/**
 * The ṭabaqāt of the grammarians (/<locale>/tabaqat/): the overview of the ṭabaqāt works on the site whole, Ibn
 * al-Anbārī's Nuzhat al-alibbāʾ and al-Suyūṭī's Bughyat al-wuʿāt, each with its author, print, order and number of
 * entries, and a word on how the two fit together. Each book has its page ([book]/index.astro).
 */
export const getStaticPaths = localePaths;
const { locale } = Astro.params as { locale: string };
const ui = t(locale);
const T = ui.kb.tabaqat;
const O = T.overview;
const books = tabaqatBooks().map((b) => {
  const size = BOOK_SIZE[b.id] ?? b.entries.length;
  const count = b.entries.length === 0 ? T.inPreparation : b.entries.length < size * 0.98 ? fmt(O.progress, { n: b.entries.length, m: size }) : fmt(T.count, { n: b.entries.length });
  return { b, text: bookText(locale, b), count };
});
const path = kbPath.tabaqat(locale);
---

<BaseLayout image={KB_SECTIONS.tabaqat.photo} title={O.title} description={O.description} path="/tabaqat/" locale={locale} bleed jsonLd={[breadcrumbs([{ name: ui.nav.home, path: `/${locale}/` }, { name: ui.kb.scholars.title, path: kbPath.scholars(locale) }, { name: O.title, path }])]}>
  <KbHero locale={locale} photo={KB_SECTIONS.tabaqat.photo} crumbs={[{ label: ui.nav.home, href: kbPath.home(locale) }, { label: ui.kb.scholars.title, href: kbPath.scholars(locale) }]} kicker={O.kicker} arabic={KB_SECTIONS.tabaqat.arabic} title={O.title} sub={O.lead} />
  <div class="kb-wrap">
    <section class="kb-section" aria-labelledby="tb-books-h">
      <div class="kb-head"><div><p class="kb-kicker">{O.booksKicker}</p><h2 id="tb-books-h">{O.booksTitle}</h2></div><p class="kufi" lang="ar">كُتُبُ الطَّبَقَاتِ</p></div>
      <ol class="tb-books">
        {books.map(({ b, text, count }, i) => (
          <li>
            <a class="tb-book" href={kbPath.tabaqat(locale, b.id)}>
              <span class="tb-n" aria-hidden="true"><span>{i + 1}</span></span>
              <span class="tb-book-text">
                <span class="kufi tb-book-ar" lang="ar">{b.arabicTitle}</span>
                <strong>{b.title}</strong>
                <span class="muted">{[`${b.author} (${b.died})`, O.order[b.order], b.edition.place + " " + b.edition.year, count].join(" · ")}</span>
                <span>{text.summary}</span>
                <span class="tb-book-open">{O.open} →</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="kb-section" aria-labelledby="tb-together-h">
      <p class="kb-kicker">{O.togetherKicker}</p>
      <h2 id="tb-together-h">{O.togetherTitle}</h2>
      <p>{O.together}</p>
      <p><a class="kb-link" href={kbPath.generations(locale)}>{O.generations} →</a></p>
    </section>
  </div>
</BaseLayout>
