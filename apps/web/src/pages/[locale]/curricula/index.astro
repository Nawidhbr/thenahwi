---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import KbHero from "../../../components/KbHero.astro";
import { localePaths, t } from "../../../i18n";
import { articleHref, articlesOf, KB_SECTIONS, kbPath } from "../../../lib/kb";
import { breadcrumbs } from "../../../lib/structured-data";

/** The curricula section of the knowledge base: its articles in reading order. */
export const getStaticPaths = localePaths;
const { locale } = Astro.params as { locale: string };
const ui = t(locale);
const S = ui.kb.curricula;
const list = articlesOf(locale, "curricula");
---

<BaseLayout image={KB_SECTIONS.curricula.photo} title={S.title} description={S.lead} path="/curricula/" locale={locale} bleed jsonLd={[breadcrumbs([{ name: ui.nav.home, path: `/${locale}/` }, { name: S.title, path: kbPath.curricula(locale) }])]}>
  <KbHero locale={locale} photo={KB_SECTIONS.curricula.photo} crumbs={[{ label: ui.nav.home, href: kbPath.home(locale) }]} arabic={KB_SECTIONS.curricula.arabic} title={S.title} sub={S.lead} />
  <div class="kb-wrap">
    <section class="kb-section">
      <ol class="kb-rows u-23868a">
        {list.map((a, n) => (
          <li>
            <a class="kb-link u-1c508b" href={articleHref(locale, a)}>
              <span class="kb-kicker u-ac43ea">{n + 1}</span>
              <span><strong>{a.title}</strong><span class="muted">{a.summary}</span></span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </div>
</BaseLayout>
