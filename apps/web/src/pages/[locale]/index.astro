---
import Photo from "../../components/Photo.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import KbHero from "../../components/KbHero.astro";
import KbBand from "../../components/KbBand.astro";
import { getBackground } from "@nahwi/content";
import { photoSrc } from "../../config/photos";
import { PARENT, SITE } from "../../config/site";
import { fmt, localePaths, t } from "../../i18n";
import { articleHref, articlesOf, catalogueCounts, diedYear, KB_BOOKS, KB_SECTIONS, kbPath, ROMAN, shortDied, shortName } from "../../lib/kb";
import { organization, website } from "../../lib/structured-data";

import parentNewsScript from "../../scripts/parent-news.js?url";
import homeSearchScript from "../../scripts/home-search.js?url";
/** The home page: the knowledge base of ṣarf and naḥw, with the way into the study portal. */
export const getStaticPaths = localePaths;
const { locale } = Astro.params as { locale: string };
const ui = t(locale);
const H = ui.kb.home;
const curricula = articlesOf(locale, "curricula").filter((a) => a.slug !== "curricula-overview");
const overview = articlesOf(locale, "curricula").find((a) => a.slug === "curricula-overview");
// The newest news in its three sections (academic, publications, talks and media); items the reader has not seen yet get a "New" tile.
const roles = ui.book.roles as Record<string, string>;
// The first sentence, not cut at an abbreviation ("b.", "ed.").
const firstSentence = (x: string) => x.split(/(?<=[^\s.]{3}[.!?])\s(?=[A-Z\u00C0-\u024F"'‘“(])/)[0];
// A line of scholars through the centuries: the authors of the handbooks and their great forerunners.
// The masters beside the handbooks: the grammarians of the knowledge base, by date of death.
const timelineSlugs = ["sibawayh", "abd-al-qahir", "ibn-al-hajib", "zanjani", "ibn-malik", "radi", "ibn-ajurrum", "ibn-hisham", "ibn-aqil", "sharif-jurjani", "jami", "birgivi", "hamalawi"];
const people = getBackground(locale).people;
// The handbooks on the home page: the six of KB_BOOKS, by date of death.
const homeBooks = [...KB_BOOKS].sort((a, b) => parseInt(a.died, 10) - parseInt(b.died, 10));
const timeline = timelineSlugs.map((s) => people.find((p) => p.slug === s)).filter((p) => p !== undefined).sort((a, b) => diedYear(a) - diedYear(b));
---

<BaseLayout image="painted-arch-allah-kafi" title={SITE.name} description={ui.kb.home.lead} path="/" locale={locale} bleed jsonLd={[organization(), website(locale)]}>

  <KbHero locale={locale} photo="painted-arch-allah-kafi" kicker={H.kicker} arabic="الصَّرْفُ وَالنَّحْوُ" title={H.title} sub={H.lead}>
    <form class="kb-search" role="search" data-kb-search>
      <label for="kb-q" class="visually-hidden">{H.search}</label>
      <input id="kb-q" type="search" placeholder={H.search} autocomplete="off" />
      <button type="submit">{H.searchButton}</button>
    </form>
    <p class="kb-parent" set:html={fmt(ui.parent.line, { mantiqi: `<a href="${PARENT.url}/">${PARENT.name}</a>` })} />
  </KbHero>

  <section class="home-split" aria-label={`${H.handbooksKicker} · ${H.mastersKicker}`}>
    <div class="home-books">
      <div class="home-split-head">
        <div><p class="kb-kicker">{H.handbooksKicker}</p><p class="home-split-lead">{H.handbooksLead}</p></div>
        <p class="kufi" lang="ar">المُتُون</p>
      </div>
      <ol class="home-book-list">
        {homeBooks.map((b, n) => {
          const c = catalogueCounts(b.id);
          return (
            <li>
              <a href={kbPath.book(locale, b.id)}>
                <span class="home-book-n">{ROMAN[n]}</span>
                <Photo slug={b.photo} sizes="84px" max={320} width={84} height={84} />
                <span class="home-book-text">
                  <strong>{b.title}</strong>
                  <span>{fmt(ui.kb.books.by, { author: b.author, died: b.died })}{c.all > 0 && <> · {c.all === 1 ? H.worksOne : fmt(H.works, { n: c.all })}</>}</span>
                </span>
                <span class="kufi" lang="ar">{b.arabic}</span>
              </a>
            </li>
          );
        })}
      </ol>
      <p class="home-split-more"><a href={kbPath.books(locale)}>{H.library} →</a></p>
    </div>
    <div class="home-masters">
      <div class="home-split-head">
        <div><p class="kb-kicker">{H.mastersKicker}</p><p class="home-split-lead">{H.mastersLead}</p></div>
        <p class="kufi" lang="ar">{KB_SECTIONS.scholars.arabic}</p>
      </div>
      <ol class="home-master-list">
        {timeline.map((p) => (
          <li>
            <a href={kbPath.scholar(locale, p.slug)}>
              <span class="home-master-date">{shortDied(p.died, locale)}</span>
              <span class="home-master-text">
                <strong>{shortName(p)}</strong>
                <span>{p.roles.slice(0, 2).map((r) => roles[r] ?? r).join(" · ")}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
      <p class="home-split-more"><a href={kbPath.scholars(locale)}>{H.allScholars} →</a> <a href={kbPath.generations(locale)}>{H.generationsLink} →</a></p>
    </div>
  </section>

  <div class="kb-wrap">
    {/* The news of naḥw and ṣarf, from The Mantiqi (scripts/parent-news.js, config/site.ts PARENT). */}
    <section class="kb-section home-news parent-news" aria-labelledby="latest-h" data-parent-news data-feed={PARENT.feed} data-field={PARENT.newsField} data-max="3" data-none={ui.kb.news.none}>
      <div class="kb-head">
        <div><p class="kb-kicker">{H.latestKicker}</p><h2 id="latest-h">{H.newsTitle}</h2><p class="muted u-mt4">{H.newsLead}</p></div>
        <p class="home-news-all"><a href={kbPath.news(locale)}>{H.allNews} →</a></p>
      </div>
      <p class="muted" data-parent-news-state>{ui.kb.news.loading}</p>
      <ul class="kb-news" data-parent-news-list hidden></ul>
    </section>
    <script is:inline src={parentNewsScript}></script>

    <KbBand id="curricula" photo={KB_SECTIONS.curricula.photo} kicker={H.curriculaKicker} title={H.curriculaTitle} arabic={KB_SECTIONS.curricula.arabic} href={kbPath.curricula(locale)} />
    <section class="kb-grid u-319c15">
      {curricula.map((a) => <a class="kb-link" href={articleHref(locale, a)}><strong>{a.title}</strong><span class="muted">{a.summary.split(/(?<=[.!?])\s/)[0]}</span></a>)}
      {overview && <a class="kb-link" href={articleHref(locale, overview)}><strong>{overview.title} →</strong><span class="muted">{overview.summary.split(/(?<=[.!?])\s/)[0]}</span></a>}
    </section>

    <section class="kb-cta u-e1837b">
      <Photo slug={KB_SECTIONS.study.photo} sizes="(max-width: 760px) 100vw, 560px" max={800} />
      <div class="kb-cta-text">
        <p class="kb-kicker">{H.studyKicker}</p>
        <p class="kufi" lang="ar">{KB_SECTIONS.study.arabic}</p>
        <p>{H.studyTitle}</p>
        <a class="kb-btn" href={kbPath.study(locale)}>{H.studyCta}</a>
      </div>
    </section>
  </div>
  <script is:inline src={homeSearchScript}></script>
</BaseLayout>
