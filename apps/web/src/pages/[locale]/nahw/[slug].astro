---
import KbArticle from "../../../components/KbArticle.astro";
import { LIVE_LOCALES, t } from "../../../i18n";
import { articlesOf, KB_SECTIONS, kbPath } from "../../../lib/kb";

export function getStaticPaths() {
  return LIVE_LOCALES.flatMap((locale) => articlesOf(locale, "nahw").map((article) => ({ params: { locale, slug: article.slug }, props: { article } })));
}
const { locale } = Astro.params as { locale: string };
const { article } = Astro.props;
const ui = t(locale);
---

<KbArticle locale={locale} article={article} siblings={articlesOf(locale, "nahw")} section={{ label: ui.kb.nahw.title, href: kbPath.nahw(locale), arabic: KB_SECTIONS.nahw.arabic }} />
