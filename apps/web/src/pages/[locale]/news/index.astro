---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import KbHero from "../../../components/KbHero.astro";
import { fmt, localePaths, t } from "../../../i18n";
import { KB_SECTIONS, kbPath } from "../../../lib/kb";
import { breadcrumbs } from "../../../lib/structured-data";
import { PARENT } from "../../../config/site";
import parentNewsScript from "../../../scripts/parent-news.js?url";

/**
 * The news of naḥw and ṣarf. The Nahwi gathers no news of its own: The Mantiqi, the parent site, does, in the field
 * `nahw` of its news (decisions 2026-11-26). This page reads that field from The Mantiqi's feed in the browser
 * (scripts/parent-news.js) and links to The Mantiqi's own news page, so the news stays in one place.
 */
export const getStaticPaths = localePaths;
const { locale } = Astro.params as { locale: string };
const ui = t(locale);
const N = ui.kb.news;
const mantiqi = `<a href="${PARENT.url}/">${PARENT.name}</a>`;
---

<BaseLayout image={KB_SECTIONS.news.photo} title={N.title} description={N.lead} path="/news/" locale={locale} bleed jsonLd={[breadcrumbs([{ name: ui.nav.home, path: `/${locale}/` }, { name: N.title, path: kbPath.news(locale) }])]}>
  <link slot="head" rel="alternate" type="application/rss+xml" title={N.parentRss} href={PARENT.feed} />
  <KbHero locale={locale} photo={KB_SECTIONS.news.photo} crumbs={[{ label: ui.nav.home, href: kbPath.home(locale) }]} arabic={KB_SECTIONS.news.arabic} title={N.title} sub={N.lead}>
    <p class="u-178f4c"><a class="kb-btn" href={PARENT.news}>{N.allAtParent} <span aria-hidden="true">↗</span></a></p>
  </KbHero>
  <div class="kb-wrap u-pb64 parent-news-wrap">
    <section class="parent-news" data-parent-news data-feed={PARENT.feed} data-field={PARENT.newsField} data-max="30" data-none={N.none}>
      <p class="muted parent-news-from" set:html={fmt(N.fromParent, { mantiqi })} />
      <p class="muted" data-parent-news-state>{N.loading}</p>
      <ul class="kb-news" data-parent-news-list hidden></ul>
      <p class="parent-news-all"><a href={PARENT.news}>{N.allAtParent} →</a></p>
    </section>
  </div>
  <script is:inline src={parentNewsScript}></script>
</BaseLayout>
