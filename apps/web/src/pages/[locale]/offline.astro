---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localePaths, t } from "../../i18n";

export const getStaticPaths = localePaths;
const { locale } = Astro.params as { locale: string };
const ui = t(locale);
---

<BaseLayout title={ui.offline.title} description={ui.offline.description} path="/offline/" locale={locale} noindex>
  <section class="card">
    <h1>{ui.offline.title}</h1>
    <p>{ui.offline.body}</p>
    <p><a class="btn btn-red" href={`/${locale}/`}>{ui.offline.back}</a></p>
  </section>
</BaseLayout>
