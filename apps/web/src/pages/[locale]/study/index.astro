---
import Photo from "../../../components/Photo.astro";
import LevelCard from "../../../components/study/LevelCard.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { localTerms } from "../../../lib/localize";
import { tracks, primers, primerLessons, primerPath, levelNumber, bookName } from "../../../lib/course";
import { primerIn } from "@nahwi/content";
import { MADRASAS, levelCourses, type Subject } from "../../../config/madrasas";
import { PHOTOS, photoSrc } from "../../../config/photos";
import { fmt, localePaths, t } from "../../../i18n";
import { previews } from "../../../config/previews";
import { course, courseList } from "../../../lib/structured-data";

import studyLevelsScript from "../../../scripts/study-levels.js?url";
export const getStaticPaths = localePaths;

const { locale } = Astro.params as { locale: string };
const ui = t(locale);
const terms = localTerms(locale);
const M = ui.madrasa;
const photoOf = (slug: string) => PHOTOS.find((x) => x.slug === slug);
const levelText = M.levels as Record<string, { title: string; arabic: string; lead: string }>;
const pathText = M.paths as Record<string, { name: string; short: string; arabic: string; lead: string }>;
const traditions = M.traditions as Record<string, string>;
// Each madrasa path with its four levels (config/madrasas.ts): the first reading of the terms, primer courses,
// books read lesson by lesson, or a book in preparation. A level whose books do not exist yet counts as in preparation.
const havePrimers = primers();
const haveTracks = tracks();
const allPreviews = previews();
// A level after the first has two lanes side by side, ṣarf and naḥw (config/madrasas.ts): each book is a card of its
// own, numbered 2a, 2b … across the level (levelNumber), with its name, Arabic title and first sentence; a book in
// preparation is a quiet card. A locked card names what to pass first (`prev`): the card before it in its lane, or the
// level before.
const firstSentence = (text: string) => text.split(/(?<=[.!?۔])\s+/)[0];
const soonBooks = M.soonBooks as Record<string, { title: string; arabic: string }>;
const lanesText = M.lanes as Record<Subject, { name: string; arabic: string; lead: string }>;
const stages = M.stages as Record<string, string>;
type Card = { n: number; label: string; title: string; arabic: string; lead: string; href: string; kind: string; books: string[]; count: string; lessons: number; soon: boolean; prev: string };
const bookCard = (id: string, n: number, label: string, prev: string): Card => {
  const pr = havePrimers.find((x) => x.id === id);
  const tr = haveTracks.find((x) => x.book.id === id);
  if (pr) {
    const own = primerIn(pr, locale);
    const lessons = primerLessons(pr).length;
    return { n, label, title: own.title, arabic: pr.arabicTitle, lead: firstSentence(own.summary), href: primerPath(locale, id), kind: "books", books: [id], count: fmt(ui.track.lessons, { n: lessons }), lessons, soon: false, prev };
  }
  if (tr) return { n, label, title: bookName(tr.book, locale).title, arabic: tr.book.arabicTitle, lead: "", href: `/${locale}/study/${id}/`, kind: "books", books: [id], count: fmt(ui.track.lessons, { n: tr.lessons.length }), lessons: tr.lessons.length, soon: false, prev };
  const name = soonBooks[id] ?? { title: id, arabic: "" };
  return { n, label, title: name.title, arabic: name.arabic, lead: "", href: "", kind: "soon", books: [], count: "", lessons: 0, soon: true, prev };
};
const paths = MADRASAS.map((m) => {
  let before = ""; // the label of the last level that has courses, for the locked cards of the next
  const blocks = m.levels.map((lv) => {
    const text = levelText[`${m.id}-${lv.n}`] ?? { title: fmt(ui.track.trackName, { track: String(lv.n) }), arabic: "", lead: "" };
    const heading = lv.stage ? fmt(M.levelStage, { n: String(lv.n), stage: stages[lv.stage] ?? lv.stage }) : fmt(M.levelN, { n: String(lv.n) });
    const base = { n: lv.n, label: String(lv.n), title: `${heading}: ${text.title}`, arabic: text.arabic, lead: text.lead };
    if (lv.terms) {
      before = String(lv.n);
      return { n: lv.n, heading, text, single: { ...base, href: `/${locale}/study/mabadi/`, kind: "terms", books: [] as string[], count: fmt(ui.home.termsCount, { n: terms.length }), lessons: terms.length, soon: false, prev: "" } as Card };
    }
    if (!lv.lanes) {
      const single: Card = lv.soon || !(lv.primers?.length || lv.books?.length)
        ? { ...base, href: "", kind: "soon", books: [], count: "", lessons: 0, soon: true, prev: before }
        : bookCard([...(lv.primers ?? []), ...(lv.books ?? [])][0], lv.n, String(lv.n), before);
      if (!single.soon) before = String(lv.n);
      return { n: lv.n, heading, text, single };
    }
    const courses = levelCourses(lv).map((c) => c.id);
    const labelOf = (id: string) => (courses.length > 1 ? levelNumber(ui, lv.n, courses.indexOf(id)) : String(lv.n));
    const lanes = (["sarf", "nahw"] as const).map((subject) => {
      const items = lv.lanes!.find((x) => x.subject === subject)?.items ?? [];
      let prev = before;
      const cards = items.map((it) => {
        if (it.kind === "soon") return bookCard(it.id, lv.n, "", prev);
        const c = bookCard(it.id, lv.n, labelOf(it.id), prev);
        prev = c.label;
        return c;
      });
      // A lane this level does not have: where it begins (on the Ottoman path naḥw begins after ṣarf), or that it rests.
      const startsAt = m.levels.find((x) => x.n > lv.n && x.lanes?.some((l) => l.subject === subject))?.n;
      const hadBefore = m.levels.some((x) => x.n < lv.n && x.lanes?.some((l) => l.subject === subject));
      const note = cards.length ? "" : startsAt && !hadBefore ? fmt(M.laneStarts, { lane: lanesText[subject].name, n: String(startsAt) }) : fmt(M.laneNone, { lane: lanesText[subject].name });
      return { subject, cards, note };
    });
    if (courses.length) before = String(lv.n);
    return { n: lv.n, heading, text, lanes };
  });
  const cards = blocks.flatMap((b) => (b.single ? [b.single] : b.lanes!.flatMap((l) => l.cards)));
  return { m, blocks, cards };
});
// The levels as courses for search engines (those in preparation left out).
const courses = paths.flatMap(({ m, cards }) => cards.filter((c) => !c.soon).map((c) => course(locale, c.n, `${pathText[m.id].name}: ${c.title}`, c.lead, c.href, c.lessons)));
// Preview lessons of the later levels: the hero's button picks one at random, a locked level's window offers those of its books.
const previewHrefs = allPreviews.map((p) => p.href(locale));
const previewsFor = (books: string[]) => allPreviews.filter((p) => books.includes(p.slug.replace(/-\d+$/, ""))).map((p) => p.href(locale));
---

<BaseLayout title={ui.kb.nav.study} description={ui.meta.homeDescription} path="/study/" locale={locale} wide jsonLd={[courseList(courses)]}>
  <header class="study-head">
    {/* Before a path is chosen: "Choose your madrasa" and the three cards. After: the chosen path as the title, with
        a quiet "Change path" that opens the cards again (scripts/study-levels.js). */}
    <h1 id="madrasa-title">
      <span class="study-title-none">{M.title}</span>
      {MADRASAS.map((m) => <span class="study-title-path" data-title-path={m.id}>{pathText[m.id].name} <span class="ar" lang="ar">{pathText[m.id].arabic}</span></span>)}
    </h1>
    <p class="lead study-lead-none">{M.leadShort}</p>
    <p class="study-change"><button type="button" class="study-change-btn" aria-expanded="false" aria-controls="madrasa" data-change-path>{M.change}</button> <span class="muted" aria-hidden="true">·</span> <a class="study-change-btn" href={`/${locale}/study/progress/`}>{ui.overview.title}</a></p>
    <div class="hero-actions">
      <a class="btn btn-red" hidden href="#levels-title" id="home-continue" data-label={ui.home.continueTo} data-start-label={M.startWith}>{ui.home.start}</a>
      {previewHrefs.length > 0 && <a class="btn btn-outline" href={previewHrefs[0]} data-previews={JSON.stringify(previewHrefs)}>{ui.preview.button}</a>}
    </div>
  </header>

  <section class="levels madrasas" id="madrasa" aria-labelledby="madrasa-title">
    <ul class="madrasa-list">
      {
        MADRASAS.map((m) => (
          <li>
            <button type="button" class="card madrasa-card" data-pick={m.id} aria-describedby={`madrasa-${m.id}-lead`}>
              <span class="madrasa-body">
                <span class="madrasa-chosen">{M.chosen}</span>
                <strong class="madrasa-name">{pathText[m.id].name}</strong>
                <span class="ar" lang="ar">{pathText[m.id].arabic}</span>
                <span class="madrasa-trad">{m.traditions.map((x) => traditions[x] ?? x).join(" · ")}</span>
                <span class="madrasa-lead" id={`madrasa-${m.id}-lead`}>{pathText[m.id].lead}</span>
                {photoOf(m.photo)?.place && <span class="madrasa-place">{photoOf(m.photo)!.place}</span>}
              </span>
              <span class="madrasa-photo">
                <Photo slug={m.photo} sizes="(max-width: 760px) 40vw, 240px" max={800} alt={photoOf(m.photo)?.alt ?? ""} width={400} height={600} />
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="levels" aria-labelledby="levels-title">
    <h2 id="levels-title">{ui.home.levelsTitle}</h2>
    <p class="muted madrasa-none">{M.none}</p>
    {
      paths.map(({ m, blocks }) => (
        <div data-path={m.id}>
          <ol class="level-list">
            {blocks.map((b) =>
              b.single ? (
                <li>
                  <LevelCard c={b.single} ui={ui} previews={b.single.prev ? previewsFor(b.single.books) : []} />
                </li>
              ) : (
                <li class="level-block">
                  <div class="level-block-head">
                    <span class="tile-wrap" aria-hidden="true">
                      <span class="tile tile-filled"><span>{b.n}</span></span>
                    </span>
                    <div>
                      <h3 class="level-block-title">{b.heading}: {b.text.title}</h3>
                      {b.text.arabic && <p class="ar level-card-ar" lang="ar">{b.text.arabic}</p>}
                      {b.text.lead && <p class="level-card-lead">{b.text.lead}</p>}
                    </div>
                  </div>
                  <div class="level-lanes">
                    {b.lanes!.map((lane) => (
                      <section class={`lane lane-${lane.subject}`} data-lane={lane.subject} aria-label={`${lanesText[lane.subject].name}: ${b.heading}`}>
                        <p class="lane-head">
                          <strong>{lanesText[lane.subject].name}</strong> <span class="ar" lang="ar">{lanesText[lane.subject].arabic}</span>
                          <span class="lane-lead muted">{lanesText[lane.subject].lead}</span>
                        </p>
                        {lane.cards.length > 0 ? (
                          <ol class="lane-list">
                            {lane.cards.map((c) => (
                              <li>
                                <LevelCard c={c} ui={ui} previews={c.prev ? previewsFor(c.books) : []} />
                              </li>
                            ))}
                          </ol>
                        ) : (
                          <p class="lane-none muted">{lane.note}</p>
                        )}
                      </section>
                    ))}
                  </div>
                </li>
              ),
            )}
          </ol>
        </div>
      ))
    }
    <dialog class="level-dialog" id="level-dialog" aria-labelledby="level-dialog-title">
      <p class="eyebrow"><span class="lock-glyph" aria-hidden="true"></span><span data-d-state></span></p>
      <h2 id="level-dialog-title" data-d-title></h2>
      <p class="ar" lang="ar" data-d-ar></p>
      <p data-d-lead></p>
      <p class="muted" data-d-meta></p>
      <div class="hero-actions">
        <a class="btn btn-red" data-d-preview href="#">{ui.preview.button}</a>
        <button type="button" class="btn btn-outline" data-d-close>{ui.preview.close}</button>
      </div>
    </dialog>
  </section>

  <script is:inline src={studyLevelsScript} data-vars={JSON.stringify({ progress: ui.home.levelProgress, lockedText: ui.home.levelLocked, studied: ui.home.termsStudied, dialogLocked: ui.preview.dialogLocked, dialogSoon: ui.preview.dialogSoon })}></script>
</BaseLayout>
