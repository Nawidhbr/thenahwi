---
import { t } from "../i18n";
import { SUPPORT } from "../config/site";
import { CHECKOUT } from "../config/pricing";

/**
 * The support window ("Steun ons", config/site.ts SUPPORT): opened by any [data-support] (the header's button and
 * the footer's link): a gift of any amount at the donation page (opens in a new tab). Rendered only once SUPPORT.donateUrl is set.
 *
 * Now and then it also opens by itself (scripts/support-nudge.js decides when): never on the first pages, never
 * more than once a month, longer after "Not now" or a gift, never on a page with a test, a lock, the account,
 * prices or legal pages, and never to a reader with full access.
 */
interface Props { locale: string }
const { locale } = Astro.props;
const ui = t(locale);
const U = ui.support;
---

{SUPPORT.donateUrl && (
  <dialog class="sub-dialog support-dialog" data-support-dialog aria-labelledby="support-title">
    <div class="sub-panel">
      <p class="kb-kicker">{U.kicker}</p>
      <h2 id="support-title">{U.title}</h2>
      <p class="support-body">{U.body}</p>
      <p class="sub-fine">{U.thanks}</p>
    </div>
    <div class="sub-main">
      <button type="button" class="sub-close" data-support-close aria-label={U.close}>
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
      <div class="support-way">
        <h3 class="account-h">{U.donateTitle}</h3>
        <p class="account-fine">{U.donateBody}</p>
        <a class="account-primary" href={SUPPORT.donateUrl} target="_blank" rel="noopener">{U.donateCta} ↗</a>
      </div>
      <p class="account-links">
        {CHECKOUT && <a href={`/${locale}/pricing/`} data-subscribe="yearly">{ui.subscribe.kicker} →</a>}
        <button type="button" data-support-later>{U.notNow}</button>
      </p>
    </div>
  </dialog>
)}

<script>
  import { nudge } from "../scripts/support-nudge";
  // Opens the support window from any [data-support]; a plain link to the donation page without the window.
  const dialog = document.querySelector<HTMLDialogElement>("[data-support-dialog]");
  // Not in the apps: the Android app takes no payments, and the iPhone app sells full access only through Apple
  // (data-app, scripts/head-settings.js).
  if (dialog && !document.documentElement.dataset.app) {
    document.addEventListener("click", (e) => {
      const el = (e.target as Element | null)?.closest?.("[data-support]");
      if (!el) return;
      e.preventDefault();
      dialog.showModal();
      dialog.querySelector<HTMLElement>(".account-primary")?.focus();
    });
    dialog.querySelector("[data-support-close]")?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (e) => { if (e.target === dialog) dialog.close(); });
    // The subscribe link inside closes this window first, so the subscribe window can open.
    dialog.querySelector("[data-subscribe]")?.addEventListener("click", () => dialog.close());
    nudge(dialog);
  }
</script>
