---
import { RTL, t } from "../i18n";

/**
 * Our translation of a passage, under the passage itself, behind a fold that starts closed: the translation and a
 * button that copies it (scripts/copy-text.js, loaded by the page). That it was made with the help of AI and that the
 * original is what counts is said once, in the source note (lib/sources.ts), not under every passage. `html` is set as it is (word pop-ups); `copy` is its plain text.
 * `variants` are the translations in the other languages of the texts (Indonesian, Turkish, Urdu, Persian, Arabic):
 * the one the reader chose in the settings (`data-trlang` on <html>, scripts/settings-menu.js) is shown instead, where
 * the passage has it (global.css, "The language of the translations").
 */
interface Props {
  locale: string;
  html: string;
  copy: string;
  /** The language of the translation when it is not the page's (an English fallback). */
  lang?: string;
  /** Whether it is the English fallback of a page in another language. */
  english?: boolean;
  variants?: { lang: string; text: string }[];
}
const { locale, html, copy, lang, english, variants = [] } = Astro.props;
const P = t(locale).primer;
const names = t(locale).header.trLangs as Record<string, string>;
const own = lang ?? locale;
---

<details class="primer-tr">
  <summary>{english && !variants.length ? P.englishTranslation : P.translation}</summary>
  <div class="tr-set">
    <div class="tr-v" data-tr-lang={own}>
      {variants.length > 0 && <p class="tr-name">{names[own] ?? own}</p>}
      <p class="seg-en" lang={lang} set:html={html} />
      <p class="primer-tools"><button type="button" class="btn btn-outline btn-small" data-copy={copy} data-done={P.copied}>{P.copyTranslation}</button></p>
    </div>
    {
      variants.filter((v) => v.lang !== own).map((v) => (
        <div class="tr-v" data-tr-lang={v.lang} lang={v.lang} dir={RTL.has(v.lang) ? "rtl" : "ltr"}>
          <p class="tr-name">{names[v.lang] ?? v.lang}</p>
          <p class={RTL.has(v.lang) ? "seg-en seg-rtl" : "seg-en"}>{v.text}</p>
          <p class="primer-tools"><button type="button" class="btn btn-outline btn-small" data-copy={v.text} data-done={P.copied}>{P.copyTranslation}</button></p>
        </div>
      ))
    }
  </div>
</details>
