---
/**
 * The site's accounts and address as one row: an icon, the name in bold and the handle beside it (as on Hanafi Atlas).
 * Under every page in the footer, and stacked in the side panel of the contact page (`stack`, without the address,
 * which that panel shows above it). The accounts come from SITE.social; the word for email from the UI dictionary.
 */
import { SITE } from "../config/site";
import { t } from "../i18n";

interface Props { locale: string; stack?: boolean }
const { locale, stack = false } = Astro.props;
const ui = t(locale);
const items = [
  ...SITE.social.map((x) => ({ ...x, me: true })),
  ...(stack ? [] : [{ name: ui.footer.email, kind: "email", handle: SITE.email, url: `mailto:${SITE.email}`, me: false }]),
];
---
<ul class:list={["social-links", { "social-links-stack": stack }]} aria-label={ui.contact.followLabel}>
  {items.map((x) => (
    <li>
      <a href={x.url} rel={x.me ? "me noopener" : undefined}>
        {x.kind === "instagram" && (
          <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.6" class="dot"></circle></svg>
        )}
        {x.kind === "telegram" && (
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M21.5 2.5 14.8 21l-3.9-8.4L2.5 8.8Z"></path><path d="M21.5 2.5 10.9 12.6"></path></svg>
        )}
        {x.kind === "x" && (
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 4l14 16M19 4 5 20"></path></svg>
        )}
        {x.kind === "email" && (
          <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="2.5" y="5" width="19" height="14" rx="2"></rect><path d="m3 6.5 9 6.5 9-6.5"></path></svg>
        )}
        <strong>{x.name}</strong>
        <span dir="ltr">{x.handle}</span>
      </a>
    </li>
  ))}
</ul>
