---
import Translation from "./Translation.astro";
import { fmt, t } from "../i18n";
import { scanHref } from "../lib/tabaqat";
import type { TabaqatBook, TabaqatParagraph } from "@nahwi/content";

/**
 * Paragraphs of a ṭabaqāt book (an entry, the preface, the closing): the vocalised Arabic of the print (verse as
 * hemistichs side by side), a button that copies it and its page with a link to that page of the scan, and our English
 * under it behind a fold (Translation.astro). A sub-heading of the print stands out as one. The page loads
 * scripts/copy-text.js.
 */
interface Props {
  book: TabaqatBook;
  paragraphs: TabaqatParagraph[];
  locale: string;
}
const { book, paragraphs, locale } = Astro.props;
const ui = t(locale);
const P = ui.primer;
const T = ui.kb.tabaqat;
const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;");
// A paragraph is prose, verse ("hemistich * hemistich", one line of verse a line), or prose that runs into verse: each
// run of prose lines becomes a paragraph, each verse line two halves side by side (the classes of PrimerOriginal).
const runs = (ar: string) => {
  const out: ({ prose: string } | { verse: string[][] })[] = [];
  for (const line of ar.split("\n")) {
    const last = out[out.length - 1];
    if (line.includes(" * ")) {
      const halves = line.split(" * ");
      if (last && "verse" in last) last.verse.push(halves);
      else out.push({ verse: [halves] });
    } else if (line.trim()) {
      if (last && "prose" in last) last.prose += ` ${line}`;
      else out.push({ prose: line });
    }
  }
  return out;
};
---

{
  paragraphs.map((x, i) => (
    <div class:list={["lesson-matn", "tb-par", { "tb-sub": x.sub }]}>
      <div class="tb-ar" lang="ar">
        {runs(x.ar).map((r) => ("prose" in r ? <p class="ar seg-ar primer-original">{r.prose}</p> : <div class="ar primer-original primer-verses">{r.verse.map(([a, b]) => <p class="primer-verse"><span>{a}</span><span>{b}</span></p>)}</div>))}
      </div>
      <p class="primer-tools">
        <button type="button" class="btn btn-outline btn-small" data-copy={x.ar} data-done={P.copied}>{P.copyText}</button>
        {(i === 0 || paragraphs[i - 1].page !== x.page) && (
          <a class="seg-page muted" href={scanHref(book, x.page)} rel="noopener" title={fmt(T.pageInScan, { page: x.page })}>{fmt(P.page, { pages: x.page })}</a>
        )}
      </p>
      <Translation locale={locale} html={esc(x.en)} copy={x.en} lang="en" english={locale !== "en"} />
    </div>
  ))
}
