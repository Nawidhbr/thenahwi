        "الإِفْعَالِ",
        "الاسْتِفْعَالِ",
        "المُفَاعَلَةِ"
      ],
      "explanation": "مَصْدَرُ عَلَّمَ تَعْلِيمٌ، عَلَى وَزْنِ التَّفْعِيلِ؛ وَمِنْ ثَمَّ سُمِّيَ بَابَ التَّفْعِيلِ."
    },
    "mazid-3": {
      "prompt": "أَيُّ الفِعْلَيْنِ مَزِيدٌ فِيهِ؟",
      "options": [
        "عَلَّمَ",
        "عَلِمَ",
        "كِلَاهُمَا",
        "لَا هٰذَا وَلَا ذَاكَ"
      ],
      "explanation": "«عَلَّمَ» ضُعِّفَتْ عَيْنُهُ؛ وَ«عَلِمَ» مُجَرَّدٌ."
    }
