    "mazid-1": {
      "prompt": "مَاذَا زِيدَ لِيَصِيرَ الفِعْلُ الثَّانِي؟",
      "options": [
        "هَمْزَةٌ فِي أَوَّلِهِ",
        "تَضْعِيفُ العَيْنِ",
        "تَاءٌ فِي أَوَّلِهِ",
        "لَا شَيْءَ: وَزْنُهُمَا وَاحِدٌ"
      ],
      "explanation": "«أَكْرَمَ» عَلَى وَزْنِ أَفْعَلَ: زِيدَتْ هَمْزَةٌ قَبْلَ الأَصْلِ."
    },
    "mazid-2": {
      "prompt": "عَلَى أَيِّ وَزْنٍ مَصْدَرُ بَابِ فَعَّلَ؟",
      "options": [
